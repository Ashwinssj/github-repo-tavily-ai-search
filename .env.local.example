# Required
# The settings below are essential for the basic functionality of the system.

# OpenAI API key retrieved here: https://platform.openai.com/api-keys
# OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]

# Tavily API Key retrieved here: https://app.tavily.com/home
TAVILY_API_KEY=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

# Upstash Redis URL and Token retrieved here: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://adequate-whale-43989.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AavVAAIgcDExNWZjZWExNjUzYTA0MjczODZkMTAxMDNlNDYwMTJmMQ"
# NVIDIA NIM API Key, Base URL, and Model
NVIDIA_NIM_API_KEY=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
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
USE_NVIDIA_NIM=true  # Set to true to use NVIDIA NIM, false to use OpenAI


# Optional
# The settings below can be used optionally as needed. They don't guarantee functionality.

# Used to set the base URL path for OpenAI API requests.
# If you need to set a BASE URL, uncomment and set the following:
# OPENAI_API_BASE=

# Used to set the model for OpenAI API requests.
# If not set, the default is gpt-4-turbo.
# OPENAI_API_MODEL='gpt-4-turbo'

# Only writers can set a specific model. It must be compatible with the OpenAI API.
# USE_SPECIFIC_API_FOR_WRITER=true
# SPECIFIC_API_BASE=
# SPECIFIC_API_KEY=
# SPECIFIC_API_MODEL=